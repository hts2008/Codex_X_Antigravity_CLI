{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gravitybridge.local/schemas/task.schema.json",
  "title": "GravityBridge Task Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "type",
    "goal",
    "base_sha",
    "scope",
    "acceptance_criteria",
    "worker"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "task_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "goal": {
      "type": "string",
      "minLength": 10,
      "maxLength": 20000
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{7,64}$"
    },
    "mutating": {
      "type": "boolean",
      "default": true
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_paths", "forbidden_paths"],
      "properties": {
        "allowed_paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "forbidden_paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "context": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "validation_commands": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "effort"],
      "properties": {
        "agent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "effort": {
          "enum": ["low", "medium", "high"]
        },
        "print_timeout": {
          "type": "string",
          "pattern": "^[0-9]+[smh]$",
          "default": "30m"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "default": 2
        },
        "max_rework_cycles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "default": 3
        }
      }
    },
    "notes": {
      "type": "string",
      "maxLength": 20000
    }
  }
}
