{
  "$id": "https://gravitybridge.local/schemas/review.schema.json",
  "title": "GravityBridge Codex Review",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*(?:\\.[A-Za-z0-9_-]+)*$"
    },
    "decision": {
      "type": "string",
      "enum": [
        "ACCEPT",
        "REWORK",
        "REJECT",
        "TAKEOVER"
      ]
    },
    "blocking_findings": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "non_blocking_findings": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "override_reason": {
      "description": "Required to ACCEPT while GravityBridge validation failed (e.g. failure pre-exists on base).",
      "type": "string",
      "minLength": 10,
      "maxLength": 2000
    },
    "quality": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100
      }
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "decision"
  ]
}
