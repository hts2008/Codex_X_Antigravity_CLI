{
  "name": "@gravitybridge/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local MCP orchestration bridge between Codex and Antigravity CLI.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
