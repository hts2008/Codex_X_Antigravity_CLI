{
  "schema_version": "1.0",
  "task_id": "GB-UI-001",
  "type": "frontend_ui",
  "goal": "Improve the dashboard KPI hierarchy and responsive layout without changing backend contracts.",
  "mutating": true,
  "scope": {
    "allowed_paths": [
      "src/app/dashboard/**",
      "src/components/dashboard/**"
    ],
    "forbidden_paths": [
      "src/server/**",
      "src/db/**"
    ]
  },
  "acceptance_criteria": [
    "Existing routes remain functional.",
    "No backend API contract changes.",
    "Dashboard does not horizontally overflow at 1366px viewport width.",
    "Existing design tokens are reused where available.",
    "Project lint and build pass."
  ],
  "context": [
    "docs/design-system.md",
    "src/app/dashboard/page.tsx",
    "src/components/dashboard/KpiCard.tsx"
  ],
  "setup_commands": [
    "npm ci"
  ],
  "validation_commands": [
    "npm run lint",
    "npm run build"
  ],
  "allowed_commands": [
    "npm run test -- --run"
  ],
  "worker": {
    "agent": "gb-frontend-coder",
    "effort": "medium",
    "print_timeout": "30m"
  },
  "limits": {
    "max_retries": 2,
    "max_rework_cycles": 3,
    "max_blocker_answers": 3,
    "max_turn_tokens": 1500000,
    "max_task_tokens": 4000000,
    "max_turn_tool_steps": 250
  },
  "notes": "KPI cards are rendered in src/app/dashboard/page.tsx; KpiCard already accepts a 'size' prop. Reuse tokens from docs/design-system.md."
}
